# Настройки Django
# Скопируйте в .env и подставьте свои значения (файл .env в репозиторий не попадает).

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# База данных
# Оставьте DB_NAME пустым — будет использоваться SQLite (удобно для разработки).
# Чтобы использовать PostgreSQL, задайте DB_NAME и остальные параметры.

DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
